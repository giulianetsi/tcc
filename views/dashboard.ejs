<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <title>Dashboard</title>
</head>
<body>
    <div class="container">
        <h1 class="my-4">BEM VINDO, <%= username %></h1>
        <h2>Alertas</h2>
        <ul class="list-group">
            <% alertas.forEach(function(alerta) { %>
                <li class="list-group-item"><%= alerta.message %></li>
            <% }); %>
        </ul>
        
        <% if (isAdmin) { %>
            <a href="/add-alerta" class="btn btn-primary mt-4">Adicionar Alerta</a>
            <a href="/register-user" class="btn btn-success mt-4">Registrar Usuario</a>
        <% } %>

        <a href="/logout" class="btn btn-secondary mt-4">Sair</a>
    </div>
</body>
</html>
